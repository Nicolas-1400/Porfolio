<section id="hero" class="seccion-principal">
	<img
		src="/assets/Grupo25.jpg"
		alt="Foto del equipo"
		class="imagen-equipo-perfil img-fluid rounded-circle mb-3"
	/>
	<h1>Grupo Portfolio</h1>
	<p>Un equipo de 3 especialistas en desarrollo y diseño, convirtiendo ideas
		complejas en código limpio y soluciones funcionales.</p>
	<a href="#proyectos" class="btn-primary">Ver Nuestro Trabajo</a>
</section>

<section id="proyectos" class="seccion-proyectos">
	<h2>Nuestros Proyectos</h2>
	<div class="rejilla-proyectos">
		{{#each proyectos}}
			<div class="tarjeta-proyecto">
				<h3 class="titulo-proyecto">{{nombreProyecto}}</h3>
				{{#if empresa}}<p class="empresa-proyecto">{{empresa}}</p>{{/if}}
				<p class="fecha-proyecto">{{fecha}}</p>
				<p class="descripcion-proyecto">{{descripcion}}</p>
				<div class="lista-tecnologias">
					{{#each tecnologias}}
						<span class="insignia-tecnologia">{{this}}</span>
					{{/each}}
				</div>
				<a href="{{enlace}}" target="_blank" class="enlace-proyecto">Visitar
					Proyecto →</a>
			</div>
		{{/each}}
	</div>
</section>

<section id="nosotros" class="seccion-equipo">
	<h2>El Equipo</h2>
	<div class="rejilla-equipo">
		{{#each miembrosEquipo}}
			<div class="tarjeta-equipo">
				<h3 class="nombre-equipo"><a href="/programadores/{{id}}" class="enlace-nombre-equipo">{{nombre}} {{apellidos}}</a></h3>
				<p class="rol-equipo">{{rol}}</p>
				<div class="contacto-equipo">
					<a href="mailto:{{email}}" title="E-mail">✉️</a>
					<a href="{{linkedin}}" target="_blank" title="LinkedIn">🔗</a>
					<a href="/assets/{{nombre}}-CV.pdf" download="{{nombre}}-CV.pdf" title="Descargar CV">📄</a>
				</div>
			</div>
		{{/each}}
	</div>
</section>

<section id="contacto" class="seccion-contacto">
	<h2>Contacta con Nosotros</h2>
	<div class="row justify-content-center">
		<div class="col-lg-6 col-md-8 col-sm-10">
			{{! Bootstrap para tamaño responsive }}
			<form
				action="/contacto"
				method="POST"
				class="formulario-contacto p-4 rounded-3 shadow-lg"
			>
				{{! Clases de Bootstrap y personalizadas }}
				<div class="mb-3">
					<input
						type="text"
						name="nombre"
						class="form-control"
						placeholder="Tu Nombre (requerido)"
						required
					/>
				</div>
				<div class="mb-3">
					<input
						type="email"
						name="email"
						class="form-control"
						placeholder="Tu E-mail (requerido)"
						required
					/>
				</div>
				<div class="mb-4">
					<textarea
						name="mensaje"
						rows="5"
						class="form-control"
						placeholder="Cuéntanos sobre tu proyecto o consulta"
						required
					></textarea>
				</div>
				<button type="submit" class="btn btn-primary w-100 boton-enviar">
					Enviar Mensaje
				</button>
			</form>
		</div>
	</div>
</section>